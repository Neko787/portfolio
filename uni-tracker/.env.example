# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# Your timezone, used for the 07:00 / 13:00 / 19:00 schedule.
# Examples: Asia/Manila, Asia/Kuala_Lumpur, Europe/London, America/New_York
TZ=UTC

# Local AI model that Ollama downloads on first start.
#   qwen2.5:7b   ~4.7 GB download, wants ~8 GB of free RAM (good default)
#   llama3.2:3b  ~2 GB download, for laptops with less RAM
OLLAMA_MODEL=qwen2.5:7b

# Telegram bot token from @BotFather (README, step 1.3)
TELEGRAM_BOT_TOKEN=

# Your personal chat id with the bot (README, step 1.3)
TELEGRAM_CHAT_ID=
